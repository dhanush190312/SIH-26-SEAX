# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# A real environment variable always beats a value in this file.

# --- routing -----------------------------------------------------------------
# Mistral free "Experiment" tier. With this set, routing uses
# mistral-small-latest with native function calling; without it, the offline
# keyword router runs and says so in the trace.
# Get one at https://console.mistral.ai -> API keys (needs phone verification).
MISTRAL_API_KEY=

# auto | mistral | rules      auto = mistral when a key is present
SATQUERY_ROUTER=auto
# SATQUERY_ROUTER_MODEL=mistral-small-latest

# --- model slots -------------------------------------------------------------
# Text slot (all five language tasks):
#   auto        the tuned Qwen when a CUDA GPU is visible, else evidence rules
#   evidence    deterministic; measures, and refuses what it cannot measure
#   mistral     a cloud vision model via MISTRAL_API_KEY. Answers counting,
#               land use and free-form grounding -- but UPLOADS THE IMAGERY.
#               Never chosen by auto; you have to ask for it.
#   qwen2_5_vl  force the served Qwen (needs a GPU and the vlm extra)
SATQUERY_VLM=auto
# SATQUERY_VLM_MODEL=mistral-small-latest   any vision model on your account
# SATQUERY_CHANGE_BACKEND=auto      auto | mci | cva
# SATQUERY_FUSION_BACKEND=auto      auto | terramind | rules

# --- paths -------------------------------------------------------------------
# SATQUERY_DATA_ROOT=D:/SatQueryAI/data
# SATQUERY_RUNS_DIR=D:/SatQueryAI/runs
# SATQUERY_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# ORCA (SIH26176) - marine decision support. Everything here is optional:
# with none of it set, `python -m orca serve` runs in DEMO mode, offline.
# ---------------------------------------------------------------------------
# DEMO = bundled synthetic data | OFFLINE = last cache snapshot | LIVE = public endpoints
ORCA_MODE=DEMO
# Which source wins when two disagree (the disagreement is ALWAYS shown, never hidden)
ORCA_SOURCE_PRIORITY=incois,imd,open_model
# Marine protected areas are hard constraints unless you say otherwise
ORCA_MPA_HARD=true
# Use stale data anyway (still flagged STALE in the output). Default: never.
ORCA_ALLOW_STALE=false
ORCA_HOST=127.0.0.1
ORCA_PORT=8100
# Optional answer rephrasing: none | mistral (needs MISTRAL_API_KEY above). Every rephrasing is
# verified against the evidence and rejected if it adds a number or claims safety.
ORCA_LLM=none
